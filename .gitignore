# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyd
*.pyo

# Distribution / packaging
.Python
build/
dist/
wheels/
*.egg-info/
*.pak

# Linting and testing caches
.pytest_cache/
.ruff_cache/
.biome/

# Virtual environment
virtualenv/
venv/
venv_*
env/
env_*
.venv/
.uv/

# Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.iml

# OS-specific files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak

# Jupyter Notebook files
.ipynb_checkpoints

# Specific to academic/coursework often found in Python projects
# Remove or comment out if not applicable to specific project files
*.data
*.pickle
*.csv
*.json
*.sqlite3
*.db
*.h5
*.hdf5

# Configuration files, if not meant for version control
# .env
# *.env
# config.ini

# Output directories for reports or generated content
reports/
output/
results/

# pytest cache files
.coverage
.coverage.*
htmlcov/

# Any specific large data files often generated or included in coursework
# that should not be committed
# large_data_file.npy
# model_weights.pt
# dataset/
