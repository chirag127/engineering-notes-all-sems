# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyd
*.pyo

# Distribution / packaging
.Python
build/
dist/
wheels/
*.egg-info/
*.pak

# Linting and testing caches
.pytest_cache/
.ruff_cache/
.biome/

# Virtual environment
virtualenv/
venv/
venv_*
env/
env_*
.venv/
.uv/

# Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.iml

# OS-specific files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak

# Google Drive upload artifacts
.tmp.driveupload/

# Jupyter Notebook files
.ipynb_checkpoints

# Secrets
*.key
.env

# Note generation pipeline data (large, not needed for study)
notes/
p_s/

